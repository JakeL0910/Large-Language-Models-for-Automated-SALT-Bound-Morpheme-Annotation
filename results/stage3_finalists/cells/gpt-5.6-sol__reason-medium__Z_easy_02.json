    "{\"outputs\":[{\"id\":0,\"text\":\"C The coat is not ready yet.\"},{\"id\":1,\"text\":\"P We can check it together beside the shoe.\"},{\"id\":2,\"text\":\"P We need to decide whether the coat can be borrowed safely.\"},{\"id\":3,\"text\":\"C Then let/'us look around the front hall before we decide.\"},{\"id\":4,\"text\":\"C Although the coat is in the right place, we/'re still careful.\"},{\"id\":5,\"text\":\"C It/'s safer when both of us watch the coat.\"},{\"id\":6,\"text\":\"P We still need a place for the coat.\"},{\"id\":7,\"text\":\"P The space beside the shoe look/3s clear.\"},{\"id\":8,\"text\":\"C I put the coat behind the basket.\"},{\"id\":9,\"text\":\"P That give/3s us room to check the shoe.\"},{\"id\":10,\"text\":\"P This one is Gia/z.\"},{\"id\":11,\"text\":\"C Then put Gia/z coat near the shoe.\"},{\"id\":12,\"text\":\"C Gia can use the coat after us.\"},{\"id\":13,\"text\":\"P Then we should compare it carefully with Luke helping.\"},{\"id\":14,\"text\":\"P This coat look/3s different from the shoe.\"},{\"id\":15,\"text\":\"C Compare them before you choose either one.\"},{\"id\":16,\"text\":\"C Hers has the silver mark.\"},{\"id\":17,\"text\":\"C Right, but Luke/z has a plain mark.\"},{\"id\":18,\"text\":\"P Let me use the shoe once.\"},{\"id\":19,\"text\":\"P I will watch what happen/3s to the bag.\"},{\"id\":20,\"text\":\"C Gia/'s check/ing the shoe now.\"},{\"id\":21,\"text\":\"P I know, and this bag is still Gia/z.\"},{\"id\":22,\"text\":\"P Luke told me to save the shoe.\"},{\"id\":23,\"text\":\"C We can set it aside without losing the bag.\"},{\"id\":24,\"text\":\"C I remember the shoe from the last try.\"},{\"id\":25,\"text\":\"P It help/ed when we had to check the bag.\"},{\"id\":26,\"text\":\"P The visitor/s/z shoe/s are together.\"},{\"id\":27,\"text\":\"C The helper/s/z bag/s can share the other place.\"},{\"id\":28,\"text\":\"C This step with the shoe did not give us the result we expect/ed.\"},{\"id\":29,\"text\":\"C Maybe the shoe was too close to the bag.\"},{\"id\":30,\"text\":\"P I forgot that Gia also need/3s the shoe.\"},{\"id\":31,\"text\":\"P Then our plan must leave some room for Gia.\"},{\"id\":32,\"text\":\"C I thought this bag was yours.\"},{\"id\":33,\"text\":\"P No, it is Luke/z, and mine is under the chair.\"},{\"id\":34,\"text\":\"P The new position work/3s for the bag.\"},{\"id\":35,\"text\":\"C Then leave the towel where we can reach it.\"},{\"id\":36,\"text\":\"C I understand which step come/3s after the bag now.\"},{\"id\":37,\"text\":\"P Show Gia the plan before we finish.\"},{\"id\":38,\"text\":\"P Now the bag is ready, with the towel in a clear place.\"},{\"id\":39,\"text\":\"C Because we agree/ed to compare the mark/s and return each one, we can finish together.\"}]}"
