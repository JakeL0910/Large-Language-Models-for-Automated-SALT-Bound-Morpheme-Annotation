# Copy to .env and fill in real keys. Never commit .env.
# Models appear in the UI only when their provider key is set.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional aliases:
# LLAMA_API_KEY=   # used if GROQ_API_KEY is empty (Groq hosts Llama)
# GOOGLE_API_KEY=  # used if GEMINI_API_KEY is empty
